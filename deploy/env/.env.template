# -----------------------------------------
# ОБЩИЙ ФАЙЛ КОНФИГУРАЦИИ МИКРОСЕРВИСНОЙ АРХИТЕКТУРЫ
# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# INVENTORY СЕРВИС
# -----------------------------------------

# gRPC настройки
INVENTORY_GRPC_PORT=50051

# logger настройки
INVENTORY_LOGGER_LEVEL=info
INVENTORY_LOGGER_AS_JSON=true

# MongoDB
INVENTORY_MONGO_IMAGE=mongo:8.0
INVENTORY_EXTERNAL_MONGO_PORT=27018
INVENTORY_MONGO_HOST=inventory-db
INVENTORY_MONGO_PORT=27017
INVENTORY_MONGO_INITDB_DATABASE=inventory-db
INVENTORY_MONGO_INITDB_ROOT_USERNAME=mongo
INVENTORY_MONGO_INITDB_ROOT_PASSWORD=mongo
INVENTORY_MONGO_AUTH_DB=admin

# -----------------------------------------
# ORDER СЕРВИС
# -----------------------------------------

# gRPC настройки
ORDER_GRPC_INVENTORY_HOST=127.0.0.1
ORDER_GRPC_INVENTORY_PORT=50051
ORDER_GRPC_PAYMENT_HOST=127.0.0.1
ORDER_GRPC_PAYMENT_PORT=50052
ORDER_GRPC_HEALTH_CHECK_TIMEOUT=5s

# logger настройки
ORDER_LOGGER_LEVEL=info
ORDER_LOGGER_AS_JSON=true

# HTTP
ORDER_HTTP_SERVER_PORT=8080
ORDER_HTTP_READ_HEADER_TIMEOUT=5s
ORDER_HTTP_REQUEST_TIMEOUT=30s
ORDER_HTTP_SHUTDOWN_TIMEOUT=10s

# Postgres
ORDER_POSTGRES_IMAGE=postgres:17.0-alpine3.20
ORDER_EXTERNAL_POSTGRES_PORT=5433
ORDER_POSTGRES_USER=postgres
ORDER_POSTGRES_PASSWORD=postgres
ORDER_POSTGRES_DB=order-db
ORDER_POSTGRES_HOST=order-postgres
ORDER_POSTGRES_PORT=5432
ORDER_POSTGRES_MAX_OPEN_CONS=30
ORDER_POSTGRES_MIN_IDLE_CONS=5
ORDER_POSTGRES_MAX_CON_IDLE_TIME=5m
ORDER_POSTGRES_MAX_CON_LIFETIME=30m

# Migrations
ORDER_MIG_DIR=migrations

# -----------------------------------------
# PAYMENT СЕРВИС
# -----------------------------------------

# gRPC настройки
PAYMENT_GRPC_PORT=50052

# logger настройки
PAYMENT_LOGGER_LEVEL=info
PAYMENT_LOGGER_AS_JSON=true